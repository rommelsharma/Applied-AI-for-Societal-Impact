# TTS Agent configuration
# Copy this file to .env and adjust as needed

# HuggingFace token — removes rate limits and enables faster model downloads.
# Get yours at: https://huggingface.co/settings/tokens  (read-only token is sufficient)
HF_TOKEN=hf_your_token_here

# Inference device: auto | cuda | mps | cpu
# auto = picks cuda on Linux/WSL, mps on Apple Silicon Mac, cpu as fallback
DEVICE=auto

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Audio
TARGET_SAMPLE_RATE=24000
TARGET_LOUDNESS_DB=-20.0

# F5-TTS model variant
F5_MODEL_NAME=F5-TTS
