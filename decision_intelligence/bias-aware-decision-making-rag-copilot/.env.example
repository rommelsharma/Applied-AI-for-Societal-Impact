AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_ENDPOINT_URL=https://bedrock-runtime.us-west-2.amazonaws.com/
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Corpus selection: "public" (synthesised dossiers, committed) or
# "private" (full-book PDFs, local-only) or any other named corpus.
CORPUS_NAME=public

# Chunking profile applied during ingestion.
#   dossier - 350 words, 60 overlap (suited to short syntheses)
#   book    - 500 words, 80 overlap (suited to full-length books)
#   auto    - decide per-document by length (default)
CHUNK_PROFILE=auto

# Retrieval defaults.
RAG_TOP_K=8
# MMR (Maximal Marginal Relevance) diversification.
#   1.0 = pure relevance, 0.0 = pure diversity. 0.5-0.7 is a typical sweet spot.
RAG_MMR_LAMBDA=0.7

# Reranker. "none" disables reranking. "claude_haiku" uses Claude 3.5 Haiku
# on Bedrock as a relevance judge over FAISS top-N candidates. Off by default
# because it adds a paid model call per query. Recommended once the corpus
# exceeds ~3,000 chunks.
RAG_RERANKER=none
RAG_RERANKER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
RAG_RERANKER_CANDIDATES=24

# Optional LLM-based passage classification at indexing time.
# When false, passage_type and decision_phase are derived heuristically (free).
# When true, Claude Haiku classifies each chunk for higher-quality tags
# (a few cents per thousand chunks).
ENRICHMENT_USE_LLM=false

# --- Index-time embeddings (build_vector_index.py) ---
# When true (default), each chunk is embedded as the L2-normalised mean of
# Titan vectors for overlapping sentence windows: for each sentence, embed
# that sentence plus RAG_EMBED_SENTENCE_RADIUS sentences before and after
# (within the chunk). Improves retrieval context vs a single full-chunk embed;
# increases Bedrock embedding calls per chunk unless RAG_EMBEDDING_MAX_WINDOWS
# subsamples (0 = no cap — one embed call per sentence in the chunk).
RAG_EMBED_SENTENCE_WINDOWS=true
RAG_EMBED_SENTENCE_RADIUS=3
RAG_EMBEDDING_MAX_WINDOWS=0

# Runtime retrieval (rag/retriever.py): overlap filter + neighbour excerpts for prompts.
RAG_OVERLAP_FILTER=false
RAG_OVERLAP_CHUNK_RADIUS=2
RAG_OVERLAP_POOL_MULTIPLIER=2
RAG_OVERLAP_MMR_POOL_MULTIPLIER=8
RAG_CONTEXT_EXPAND_NEIGHBORS=0
# Hybrid retrieval (BM25 + dense + RRF)
RAG_BM25_ENABLED=true
RAG_BM25_TOP_K=20
RAG_RRF_K=60
RAG_ONTOLOGY_FILTER_MIN_RESULTS=2
RAG_QUERY_CLASSIFICATION=true
RAG_SYNTHESIS_CONTEXT=true

# Eval thresholds (groundedness heuristic in evaluation/metrics.py)
EVAL_GROUNDEDNESS_THRESHOLD=0.35
